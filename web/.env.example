# Copy to .env / Vercel Environment Variables

# --- Local (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Vercel / production (Postgres — Neon, Vercel Postgres, or Supabase) ---
# 1) In prisma/schema.prisma change: provider = "postgresql"
# 2) Set:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

COMPANY_NAME="SolarStock Warehouse"
COMPANY_ADDRESS="Your warehouse address"
